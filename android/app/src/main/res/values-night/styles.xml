<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Theme applied while app is starting (Dark mode) -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">

        <!-- Same background as light mode to avoid flash -->
        <item name="android:windowBackground">@drawable/launch_background</item>

        <!-- Android 12+ splash background -->
        <item name="android:windowSplashScreenBackground">#FFFFFF</item>

        <!-- Remove native app icon splash -->
        <item name="android:windowSplashScreenAnimatedIcon">@null</item>

        <!-- Prevent extra splash branding -->
        <item name="android:windowSplashScreenIconBackgroundColor">#FFFFFF</item>

    </style>

    <!-- Theme after Flutter loads -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>

</resources>