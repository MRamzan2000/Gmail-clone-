<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Launch theme shown while Flutter initializes -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">

        <!-- Keep same background to avoid flicker -->
        <item name="android:windowBackground">@android:color/white</item>

        <!-- Android 12+ splash background -->
        <item name="android:windowSplashScreenBackground">#FFFFFF</item>

        <!-- Remove app icon completely -->
        <item name="android:windowSplashScreenAnimatedIcon">@null</item>

        <!-- Remove icon background circle -->
        <item name="android:windowSplashScreenIconBackgroundColor">#FFFFFF</item>

    </style>

    <!-- Theme used after app starts -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>

</resources>